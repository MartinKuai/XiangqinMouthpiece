# 模型服务配置（推荐使用 MODEL_* 变量）
# 请从 Mimo 控制台复制 OpenAI-compatible Base URL 和模型名
MODEL_PROVIDER=mimo
MODEL_API_KEY=
MODEL_BASE_URL=https://api.xiaomimimo.com/v1
MODEL_NAME=mimo-v2-flash

# 演示访问码（可选，设置后前端需携带访问码）
DEMO_ACCESS_CODE=

# Legacy compatibility only. Do not use for new setup.
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=
# DEEPSEEK_MODEL=

# --- Cloudflare Pages 本地开发 ---
# 复制 .dev.vars.example 为 .dev.vars，填入真实值
# 运行：npx wrangler pages dev dist
